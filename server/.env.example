# --- Server ---
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
# Random long string. Also protects /api/diagnostics/* and /api/cron/tick (header x-diag-secret)
JWT_SECRET=change_me

# --- Database (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/venture_spark

# --- Redis (rate limiting, keys prefixed with "vs:") ---
REDIS_URL=redis://default:<password>@<host>:<port>

# --- Firebase Auth (server verifies ID tokens) ---
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Supabase Storage (post images) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_xxx
SUPABASE_BUCKET=images
SUPABASE_VIDEO_BUCKET=video

# --- Google Gemini (caption generation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Email ---
# Brevo HTTPS API (used when set; works on hosts that block SMTP such as Render free)
BREVO_API_KEY=
# Sender (must be a verified sender in Brevo)
MAIL_FROM="Venture Spark <you@example.com>"
# SMTP fallback (used only when BREVO_API_KEY is empty), e.g. Gmail + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
